# Server-side only (Vercel → Settings → Environment Variables). NEVER prefix these with VITE_.
ANTHROPIC_API_KEY=
# Optional. Default: claude-haiku-4-5-20251001 (cheapest). For higher quality: claude-sonnet-5-5
ANTHROPIC_MODEL=
N8N_LEAD_WEBHOOK_URL=
N8N_HANDOFF_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Optional extra allowed origins (comma-separated). Same-origin is always allowed.
ALLOWED_ORIGINS=
# Optional: warnings before the AI ends an abusive conversation. Default 1.
ABUSE_MAX_WARNINGS=1

# ---- WhatsApp engine (see docs/WHATSAPP-SETUP.md) ----
# Permanent System User token. NEVER the 24h token, never commit it.
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard → App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=1385944931264059
# Any long random string; must match the Verify token typed into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Optional: hours the AI stays silent after a human handoff (default 24)
WHATSAPP_HANDOFF_HOURS=24
# Password for /admin.html (24+ characters)
ADMIN_TOKEN=
# Upstash Redis — added automatically by Vercel Marketplace (or use UPSTASH_REDIS_REST_URL/TOKEN)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Existing frontend form endpoints (these ARE public by design)
VITE_FORM_CONTACT_URL=
VITE_FORM_LEAD_POPUP_URL=
VITE_FORM_WEBSITE_AUDIT_URL=
VITE_FORM_PPC_PRICING_URL=

# ---- Growth Engine (dashboard at /app, see docs/GROWTH-ENGINE.md) ----
# Postgres. Added automatically by the Supabase or Neon integration in Vercel (Storage tab).
# The pooled URL is used by the API; the direct one (if present) by migrations at build time.
DATABASE_URL=
# POSTGRES_URL= / POSTGRES_URL_NON_POOLING= (Supabase names, also accepted)
